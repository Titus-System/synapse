# ---- Serviço ----
SERVICE_NAME=api
SERVICE_DESCRIPTION=servidor API REST e coordenação de processos
SERVICE_PUBLIC_URL=https://api.synapse.com.br
VERSION=0.1.0

ENVIRONMENT=development

# ---- Observabilidade ----
# Nível mínimo de log emitido (DEBUG/INFO/WARNING/ERROR/CRITICAL).
LOG_LEVEL=INFO

# HOSTNAME é injetado pelo runtime (k8s/Docker) e vai no campo "host" do log.
# Só defina manualmente para override em ambiente local.
# HOSTNAME=

# ---- PostgreSQL ----
# O Liquibase conecta na subida da aplicação: valor errado aqui derruba o start, não
# adia o erro para a primeira query.
# POSTGRES_HOST: use "localhost" rodando fora do Docker. No deploy/docker-compose.yml
# o serviço "api" recebe "postgres" (nome do serviço do banco) automaticamente.
# POSTGRES_PORT: o compose publica 5433 no host por default; dentro da rede é 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synapse_db

# Usuário com que a api opera.
SYNAPSE_API_DB_USER=synapse_api
SYNAPSE_API_DB_PASSWORD=troque-me

# Dono do schema, usado só pelo Liquibase.
POSTGRES_OWNER_USER=postgres
POSTGRES_OWNER_PASSWORD=troque-me

# Nome dos usuários dos outros serviços, para os GRANT das migrations.
SYNAPSE_CODEGEN_DB_USER=synapse_codegen
SYNAPSE_WORKER_DB_USER=synapse_worker

# ---- SSE (GET /jobs/{id}/events) ----
# Intervalo entre comentários SSE de heartbeat, para manter a conexão viva através de
# proxy e para a api detectar o cliente que saiu. Formato ISO-8601 ou "15s"/"30m" etc.
SSE_HEARTBEAT=15s
# Tempo máximo que um emissor fica aberto sem atividade antes do container encerrá-lo.
SSE_TIMEOUT=30m

# ---- RabbitMQ ----
# RABBITMQ_HOST: use "localhost" rodando fora do Docker. No deploy/docker-compose.yml
# o serviço "api" recebe "rabbitmq" (nome do serviço do broker) automaticamente.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---- Alloy (compose) ----
# Ex.: https://logs-prod-XX.grafana.net/loki/api/v1/push
LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
# Ex.: https://prometheus-prod-XX.grafana.net/api/prom/push
PROMETHEUS_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
# Ex.: tempo-prod-XX.grafana.net:443
TEMPO_URL=tempo-prod-XX.grafana.net:443

<?xml version="1.0" encoding="UTF-8"?>

<!--
	Três destinos: app.json com tudo, error.json só com ERROR, e um console que é texto
	legível em development e o envelope JSON fora dele.
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<springProperty scope="context" name="LOG_PATH" source="app.observability.log-path" defaultValue="logs"/>
	<property name="STRUCTURED_FORMAT" value="synapse.api.core.logging.JsonLogFormatter"/>

	<springProfile name="development">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>${CONSOLE_LOG_PATTERN}</pattern>
				<charset>${CONSOLE_LOG_CHARSET}</charset>
			</encoder>
		</appender>
	</springProfile>

	<springProfile name="!development">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
				<format>${STRUCTURED_FORMAT}</format>
				<charset>${CONSOLE_LOG_CHARSET}</charset>
			</encoder>
		</appender>
	</springProfile>

	<appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_PATH}/app.json</file>
		<encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
			<format>${STRUCTURED_FORMAT}</format>
			<charset>UTF-8</charset>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<fileNamePattern>${LOG_PATH}/app.json.%i.gz</fileNamePattern>
			<minIndex>1</minIndex>
			<maxIndex>5</maxIndex>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
			<maxFileSize>10MB</maxFileSize>
		</triggeringPolicy>
	</appender>

	<!-- ERROR e acima, independente do nível configurado no root. -->
	<appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>ERROR</level>
		</filter>
		<file>${LOG_PATH}/error.json</file>
		<encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
			<format>${STRUCTURED_FORMAT}</format>
			<charset>UTF-8</charset>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<fileNamePattern>${LOG_PATH}/error.json.%i.gz</fileNamePattern>
			<minIndex>1</minIndex>
			<maxIndex>5</maxIndex>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
			<maxFileSize>10MB</maxFileSize>
		</triggeringPolicy>
	</appender>

	<!--
		Uma fila por destino: o AsyncAppender aceita um appender só e ignora os demais em
		silêncio. includeCallerData é o que materializa `module`, `function` e `line`.
	-->
	<appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
		<includeCallerData>true</includeCallerData>
		<queueSize>1024</queueSize>
		<appender-ref ref="CONSOLE"/>
	</appender>

	<appender name="ASYNC_APP_FILE" class="ch.qos.logback.classic.AsyncAppender">
		<includeCallerData>true</includeCallerData>
		<queueSize>1024</queueSize>
		<appender-ref ref="APP_FILE"/>
	</appender>

	<appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
		<includeCallerData>true</includeCallerData>
		<queueSize>1024</queueSize>
		<appender-ref ref="ERROR_FILE"/>
	</appender>

	<root level="INFO">
		<appender-ref ref="ASYNC_CONSOLE"/>
		<appender-ref ref="ASYNC_APP_FILE"/>
		<appender-ref ref="ASYNC_ERROR_FILE"/>
	</root>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>synapse</groupId>
	<artifactId>api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<error-prone.version>2.50.0</error-prone.version>
		<nullaway.version>0.14.1</nullaway.version>
		<spring-javaformat.version>0.0.48</spring-javaformat.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Expõe /actuator/prometheus e /actuator/health, raspados pelo Alloy. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Traz micrometer-tracing-bridge-otel + opentelemetry-exporter-otlp:
		     preenche traceId/spanId no MDC e exporta spans para o Alloy. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Serve o Swagger UI em /docs, apontado para o contrato estático copiado de
		     contracts/http/openapi.yaml (ver o plugin de recursos abaixo) em vez de
		     gerar um spec a partir de anotações. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>

		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>io.spring.javaformat</groupId>
				<artifactId>spring-javaformat-maven-plugin</artifactId>
				<version>${spring-javaformat.version}</version>
			</plugin>
			<!-- copia o contrato HTTP para dentro do jar. 
				 Mesma estrutura relativa de contracts/, porque
			     openapi.yaml referencia domain/*.schema.json por caminho relativo. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-openapi-contract</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/static/openapi</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/../contracts</directory>
									<includes>
										<include>http/openapi.yaml</include>
										<include>http/synapse-openapi.html</include>
										<include>domain/*.schema.json</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- $id em contracts/domain/*.schema.json é só identificador, nunca endereço
			     de verdade - contracts/ é insumo de build, nunca dependência de runtime
			     (ADR-002). Um resolvedor de $ref que trata $id como URI de fetch (caso do
			     Swagger UI) tentaria buscar https://synapse.local/... de verdade e falharia.
			     Remove o campo só desta cópia servida; os originais não mudam. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>strip-schema-ids-from-served-copy</id>
						<phase>process-classes</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<replaceregexp byline="false" encoding="UTF-8">
									<regexp pattern="&quot;\$id&quot;\s*:\s*&quot;[^&quot;]*&quot;,\s*" />
									<substitution expression="" />
									<fileset dir="${project.build.outputDirectory}/static/openapi/domain" includes="*.schema.json" />
								</replaceregexp>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<!-- Gera os metadados de app.*: sem isto a IDE acusa "Unknown property". -->
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
							<version>${project.parent.version}</version>
						</path>
						<path>
							<groupId>com.google.errorprone</groupId>
							<artifactId>error_prone_core</artifactId>
							<version>${error-prone.version}</version>
						</path>
						<path>
							<groupId>com.uber.nullaway</groupId>
							<artifactId>nullaway</artifactId>
							<version>${nullaway.version}</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<arg>-XDcompilePolicy=simple</arg>
						<arg>-XDaddTypeAnnotationsToSymbol=true</arg>
						<arg>--should-stop=ifError=FLOW</arg>
						<!-- Só o nosso código por ora; os pacotes do Spring ficam de fora. -->
						<arg>-Xplugin:ErrorProne -XepOpt:NullAway:AnnotatedPackages=synapse.api -Xep:NullAway:ERROR</arg>
					</compilerArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>

+						FROM information_schema.table_privileges
+						WHERE table_schema = 'public' AND table_name <> 'rodadas_correcao' ORDER BY 1
+						""")) {
+			while (rs.next()) {
+				permissoes.add(rs.getString(1));
+			}
+		}
+		return permissoes;
+	}

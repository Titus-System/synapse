+
+def aplicar(
+    regra: RepresentacaoRegra, parametros: dict[str, Any], *operacoes: object
+) -> tuple[dict[str, Any], dict[str, Any], list[Any]]:
+    corrigida, completos, diagnosticos = aplicar_operacoes_correcao(

+        None,
+        "privado",
+    ],
+)
+def test_ignora_operacao_invalida_sem_perder_as_validas(
+    regra: RepresentacaoRegra, invalida: object
+) -> None:
+    corrigida, _, diagnosticos = aplicar(regra, {}, invalida, PERCENTUAL)

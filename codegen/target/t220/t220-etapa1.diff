diff --git a/codegen/app/extracao/correcao.py b/codegen/app/extracao/correcao.py
new file mode 100644
index 0000000..c2fe59d
--- /dev/null
+++ b/codegen/app/extracao/correcao.py
@@ -0,0 +1,120 @@
+from collections.abc import Sequence
+from contextlib import suppress
+from copy import deepcopy
+from dataclasses import dataclass, replace
+from typing import Any, Literal, cast
+
+from jsonschema import Draft202012Validator
+from pydantic import ConfigDict, TypeAdapter
+
+from app.extracao.modelos import FalhaExtracaoError, Rebaixamento
+from app.extracao.montagem import montar_elemento
+from app.extracao.parametros import validar_parametros
+from app.extracao.schema_correcao import schema_envelope_correcao, schema_operacao_correcao
+from app.representacao_regra import RepresentacaoRegra
+from app.tipos_estado import ValorRegra
+
+
+@dataclass(frozen=True, slots=True)
+class DiagnosticoOperacao:
+    """Diagnóstico interno, sem serialização no contrato de rebaixamentos da extração."""
+
+    indice: int
+    motivo: Literal["operacao_invalida", "referencia_inexistente"]
+
+
+type DiagnosticoCorrecao = Rebaixamento | DiagnosticoOperacao
+type ResultadoCorrecao = tuple[RepresentacaoRegra, dict[str, ValorRegra], list[DiagnosticoCorrecao]]
+
+_VALOR: TypeAdapter[ValorRegra] = TypeAdapter(ValorRegra, config=ConfigDict(allow_inf_nan=False))
+
+
+@dataclass(slots=True)
+class _Elemento:
+    ref_original: str | None
+    conteudo: dict[str, ValorRegra]
+    rebaixamento: Rebaixamento | None = None
+
+
+def _aplicar(
+    operacao: dict[str, Any],
+    nucleo: dict[str, ValorRegra],
+    parametros: dict[str, ValorRegra],
+    elementos: list[_Elemento],
+    texto: str,
+) -> Literal["referencia_inexistente"] | None:
+    tipo = operacao["tipo"]
+    if tipo == "definir_nucleo":
+        valor = _VALOR.validate_python(operacao["valor"], strict=True)
+        candidato = {**nucleo, operacao["campo"]: valor}
+        RepresentacaoRegra.model_validate({"nucleo": candidato, "especificacoes": []})
+        nucleo[operacao["campo"]] = valor
+    elif tipo == "definir_parametro":
+        valor = _VALOR.validate_python(operacao["valor"], strict=True)
+        validar_parametros({**parametros, operacao["campo"]: valor})
+        parametros[operacao["campo"]] = valor
+    elif tipo == "remover_parametro":
+        parametros.pop(operacao["campo"], None)
+    elif tipo == "adicionar_elemento":
+        convertido, rebaixamento = montar_elemento(operacao["elemento"], "elem.1", texto)
+        elementos.append(_Elemento(None, convertido, rebaixamento))
+    else:
+        posicao = next(
+            (i for i, e in enumerate(elementos) if e.ref_original == operacao["ref"]), None
+        )
+        if posicao is None:
+            return "referencia_inexistente"
+        if tipo == "remover_elemento":
+            elementos.pop(posicao)
+        else:
+            convertido, rebaixamento = montar_elemento(operacao["elemento"], "elem.1", texto)
+            elementos[posicao] = _Elemento(operacao["ref"], convertido, rebaixamento)
+    return None
+
+
+def aplicar_operacoes_correcao(
+    representacao: RepresentacaoRegra,
+    parametros: dict[str, ValorRegra],
+    operacoes: object,
+    competencias_publicadas: Sequence[str],
+    *,
+    texto_correcao: str = "",
+) -> ResultadoCorrecao:
+    """Aplica um envelope desserializado; interface e diagnósticos em docs/correcao.md.
+
+    Competências publicadas são contexto, não filtro: T-277 preserva períodos fora
+    das publicadas para a validação de domínio. Não há resolução de período aqui.
+    """
+    if not Draft202012Validator(schema_envelope_correcao()).is_valid(operacoes):
+        raise FalhaExtracaoError("Envelope de correção inválido")
+
+    regra = deepcopy(representacao.para_contrato())
+    nucleo = cast(dict[str, ValorRegra], regra["nucleo"])
+    especificacoes = cast(list[dict[str, ValorRegra]], regra["especificacoes"])
+    elementos = [_Elemento(cast(str, e["ref"]), e) for e in especificacoes]
+    refs = [e.ref_original for e in elementos]
+    if len(refs) != len(set(refs)):
+        raise FalhaExtracaoError("Referências da regra atual ambíguas")
+    completos = deepcopy(validar_parametros(parametros))
+    envelope = cast(dict[str, Any], operacoes)
+    diagnosticos: list[DiagnosticoCorrecao] = []
+    # A montagem da T-203 recupera rascunhos incompletos; o envelope do item segue fechado.
+    validador = Draft202012Validator(schema_operacao_correcao(validar_elemento=False))
+    for indice, operacao in enumerate(envelope["operacoes"], 1):
+        if not validador.is_valid(operacao):
+            diagnosticos.append(DiagnosticoOperacao(indice, "operacao_invalida"))
+            continue
+        motivo: Literal["operacao_invalida", "referencia_inexistente"] | None = "operacao_invalida"
+        with suppress(ValueError, TypeError, KeyError, RecursionError):
+            motivo = _aplicar(deepcopy(operacao), nucleo, completos, elementos, texto_correcao)
+        if motivo is not None:
+            diagnosticos.append(DiagnosticoOperacao(indice, motivo))
+
+    finais: list[ValorRegra] = []
+    for indice, elemento in enumerate(elementos, 1):
+        ref = f"elem.{indice}"
+        finais.append({**elemento.conteudo, "ref": ref})
+        if elemento.rebaixamento is not None:
+            diagnosticos.append(replace(elemento.rebaixamento, ref=ref))
+    regra["especificacoes"] = finais
+    return RepresentacaoRegra.model_validate(regra), validar_parametros(completos), diagnosticos
diff --git a/codegen/app/extracao/montagem.py b/codegen/app/extracao/montagem.py
new file mode 100644
index 0000000..d73f37c
--- /dev/null
+++ b/codegen/app/extracao/montagem.py
@@ -0,0 +1,81 @@
+from typing import Any
+
+from jsonschema import Draft202012Validator
+
+from app.extracao.construtos.generico import montar_generico
+from app.extracao.lastro import conferir_numero, numeros_citados, trecho_literal
+from app.extracao.modelos import MotivoRebaixamento, Rebaixamento
+from app.extracao.registro import CONSTRUTOS_HABILITADOS
+from app.extracao.schema import schema_elemento
+from app.representacao_regra import RepresentacaoRegra
+from app.tipos_estado import ValorRegra
+
+
+def _texto_util(valor: object) -> str | None:
+    return valor if isinstance(valor, str) and valor.strip() else None
+
+
+def montar_elemento(
+    elemento: dict[str, Any], ref: str, texto: str
+) -> tuple[dict[str, ValorRegra], Rebaixamento | None]:
+    pretendido = _texto_util(elemento.get("construto_pretendido"))
+    construto = CONSTRUTOS_HABILITADOS.get(pretendido) if pretendido else None
+    descricao = _texto_util(elemento.get("descricao"))
+    trecho = _texto_util(elemento.get("trecho"))
+    incompleto = pretendido is None or descricao is None or trecho is None
+    if descricao is None:
+        if trecho is None or trecho not in texto:
+            raise ValueError("Elemento irrecuperável")
+        descricao = trecho
+
+    erros = list(Draft202012Validator(schema_elemento(construto)).iter_errors(elemento))
+    incompleto = incompleto or any(e.validator != "additionalProperties" for e in erros)
+    motivo_lastro: MotivoRebaixamento | None = (
+        "valor_sem_lastro" if trecho is not None and not trecho_literal(texto, trecho) else None
+    )
+    if (
+        trecho is not None
+        and trecho_literal(texto, trecho)
+        and not numeros_citados(descricao).issubset(numeros_citados(trecho))
+    ):
+        motivo_lastro = "valor_sem_lastro"
+    para_conversao = dict(elemento)
+    if construto is not None and not incompleto and motivo_lastro is None:
+        for chave, definicao in construto.propriedades.items():
+            if definicao.get("type") not in ("number", "integer") or chave not in elemento:
+                continue
+            campo = elemento[chave]
+            if not conferir_numero(
+                texto,
+                campo["trecho"],
+                campo["valor"],
+                percentual=chave in ("percentual", "fracao", "taxa"),
+            ):
+                motivo_lastro = "valor_sem_lastro"
+                break
+            para_conversao[chave] = campo["valor"]
+    if construto is not None and not erros and not incompleto and motivo_lastro is None:
+        try:
+            convertido = {
+                **construto.converter(para_conversao),
+                "ref": ref,
+                "construto": pretendido,
+            }
+            RepresentacaoRegra.model_validate({"nucleo": {}, "especificacoes": [convertido]})
+        except (ValueError, TypeError, KeyError):
+            incompleto = True
+        else:
+            return convertido, None
+
+    if motivo_lastro is not None:
+        descricao = (
+            trecho
+            if trecho is not None and trecho_literal(texto, trecho)
+            else "Elemento sem lastro verificável"
+        )
+    return montar_generico(ref, descricao), Rebaixamento(
+        ref=ref,
+        construto_pretendido=pretendido,
+        motivo=motivo_lastro
+        or ("campo_obrigatorio_ausente" if incompleto else "construto_nao_habilitado"),
+    )
diff --git a/codegen/app/extracao/schema_correcao.py b/codegen/app/extracao/schema_correcao.py
new file mode 100644
index 0000000..5035de3
--- /dev/null
+++ b/codegen/app/extracao/schema_correcao.py
@@ -0,0 +1,70 @@
+from copy import deepcopy
+from typing import Any
+
+from app.extracao.registro import CONSTRUTOS_HABILITADOS
+from app.extracao.schema import NUCLEO, PARAMETROS, schema_saida
+
+
+def schema_envelope_correcao() -> dict[str, Any]:
+    return {
+        "type": "object",
+        "additionalProperties": False,
+        "required": ["operacoes"],
+        "properties": {"operacoes": {"type": "array", "minItems": 1}},
+    }
+
+
+def _operacao(tipo: str, **campos: Any) -> dict[str, Any]:
+    propriedades = {"tipo": {"const": tipo}, **campos}
+    return {
+        "type": "object",
+        "additionalProperties": False,
+        "required": list(propriedades),
+        "properties": propriedades,
+    }
+
+
+def _definir(tipo: str, campos: dict[str, Any]) -> dict[str, Any]:
+    operacao = _operacao(tipo, campo={"enum": list(campos)}, valor={})
+    operacao["anyOf"] = [
+        {"properties": {"campo": {"const": nome}, "valor": schema}}
+        for nome, schema in campos.items()
+    ]
+    return operacao
+
+
+def schema_operacao_correcao(*, validar_elemento: bool = True) -> dict[str, Any]:
+    nucleo = {}
+    for nome, campo in NUCLEO["properties"].items():
+        if nome in ("loja", "marca", "cargo"):
+            nucleo[nome] = {"type": "array", "items": campo["items"]["properties"]["valor"]}
+        else:
+            nucleo[nome] = campo["properties"]["valor"]
+    parametros = {
+        nome: campo["properties"]["valor"] for nome, campo in PARAMETROS["properties"].items()
+    }
+    elemento = (
+        schema_saida(CONSTRUTOS_HABILITADOS)["properties"]["elementos"]["items"]
+        if validar_elemento
+        else {"type": "object"}
+    )
+    ref = {"type": "string", "pattern": r"^elem\.[0-9]+$"}
+    return deepcopy(
+        {
+            "anyOf": [
+                _definir("definir_nucleo", nucleo),
+                _operacao("substituir_elemento", ref=ref, elemento=elemento),
+                _operacao("remover_elemento", ref=ref),
+                _operacao("adicionar_elemento", elemento=elemento),
+                _definir("definir_parametro", parametros),
+                _operacao("remover_parametro", campo={"enum": list(parametros)}),
+            ]
+        }
+    )
+
+
+def schema_operacoes_correcao() -> dict[str, Any]:
+    """Schema fechado para a saída do modelo; recuperação por item ocorre no motor."""
+    schema = schema_envelope_correcao()
+    schema["properties"]["operacoes"]["items"] = schema_operacao_correcao()
+    return schema

          "type": "string"
        },
        {
          "format": "YYYY-MM-DD",
          "name": "data_admiss",
          "nullable": false,
          "semantics": "Minimum admission date across all six RH sources, including July; applied to every published record, including earlier competencies.",
          "source": "Data_Admiss",
          "type": "string"
        },
        {
          "format": "YYYY-MM-DD",
          "name": "data_demiss",
          "nullable": true,
          "semantics": "Earliest known termination is terminal and propagated to subsequent RH. A date before the competency starts makes the employee ineligible for commission in that competency. Observed RH remains; post-termination sales are discarded.",
          "source": "Data_Demiss",
          "type": "string"
        },
        {
          "name": "cod_cargo",
          "nullable": false,
          "semantics": "Role code.",
          "source": "Cod_Cargo",
          "type": "integer"
        },
        {
          "name": "descr_cargo",
          "nullable": false,
          "semantics": "Role description.",

# ---- Serviço ----
SERVICE_NAME=synapse-worker
SERVICE_DESCRIPTION=worker responsavel por rodar simulacao em sandbox
SERVICE_PUBLIC_URL=https://agents.syncdesk.pro

VERSION=0.1.0

ENVIRONMENT=development

# ---- Observabilidade ----
# Nível mínimo de log emitido (DEBUG/INFO/WARNING/ERROR/CRITICAL).
LOG_LEVEL=INFO

# Formato do stdout: "json" para o coletor, "text" colorido para ler no terminal.
# O container não usa este arquivo e fica no padrão "json".
LOG_FORMAT=text

# HOSTNAME é injetado pelo runtime (k8s/Docker) e vai no campo "host" do log.
# Só defina manualmente para override em ambiente local.
# HOSTNAME=

# ---- PostgreSQL ----
# POSTGRES_HOST: use "localhost" rodando fora do Docker. No deploy/docker-compose.yml
# o serviço "worker" recebe "postgres" (nome do serviço do banco) automaticamente.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synapse_db

# O usuário do worker, criado pelo initdb do compose
SYNAPSE_WORKER_DB_USER=synapse_worker
SYNAPSE_WORKER_DB_PASSWORD=troque-me

# ---- RabbitMQ ----
# RABBITMQ_HOST: use "localhost" rodando fora do Docker. No deploy/docker-compose.yml
# o serviço "worker" recebe "rabbitmq" (nome do serviço do broker) automaticamente.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---- Docker ----
# Endereço do daemon onde o sandbox de execução sobe. O acesso é verificado na
# subida do worker; sem ele o processo não sobe. Ver docs/instalacao.md.
DOCKER_HOST=unix:///var/run/docker.sock

# Imagem do sandbox, construída por worker/sandbox/Dockerfile a partir da raiz do
# monorepo. É o único parâmetro configurável da execução isolada: rede, sistema de
# arquivos, capabilities e limites são constantes do código.
SANDBOX_IMAGE=synapse-sandbox:local

# ---- Uvicorn (compose) ----
# true ativa --reload no container app (use com bind mount do código).
UVICORN_RELOAD=false

# ---- Alloy (compose) ----
# Ex.: https://logs-prod-XX.grafana.net/loki/api/v1/push
LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
# Ex.: https://prometheus-prod-XX.grafana.net/api/prom/push
PROMETHEUS_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
# Ex.: tempo-prod-XX.grafana.net:443
TEMPO_URL=tempo-prod-XX.grafana.net:443

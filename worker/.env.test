# Valores para os testes marcados "postgres"/"rabbitmq" (`make pre-commit` roda só os
# demais por padrão; ver verify.sh). Apontam para o compose de infraestrutura da raiz
# (deploy/docker-compose.yml) rodando localmente, com as credenciais de exemplo do
# deploy/.env.example — nunca segredo real.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=synapse_db
SYNAPSE_WORKER_DB_USER=synapse_worker
SYNAPSE_WORKER_DB_PASSWORD=troque-me

# Dono do schema - só os testes usam, para montar a cadeia de FKs (jobs, regras,
# prompts) que o worker não tem permissão para escrever.
POSTGRES_OWNER_USER=postgres
POSTGRES_OWNER_PASSWORD=postgres

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

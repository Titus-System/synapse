# PostgreSQL
POSTGRES_DB=synapse_db
POSTGRES_PORT=5432

# Dono do schema e usuario root do banco
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Um usuário por serviço
# Trocar um nome aqui exige trocá-lo também no .env do serviço
SYNAPSE_API_DB_USER=synapse_api
SYNAPSE_API_DB_PASSWORD=troque-me

SYNAPSE_CODEGEN_DB_USER=synapse_codegen
SYNAPSE_CODEGEN_DB_PASSWORD=troque-me

SYNAPSE_WORKER_DB_USER=synapse_worker
SYNAPSE_WORKER_DB_PASSWORD=troque-me

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Codegen
CODEGEN_PORT=8001

# Worker
WORKER_PORT=8002

# GID do grupo docker DESTA máquina, para o worker alcançar o socket montado.
# Descubra o seu com: getent group docker | cut -d: -f3
# O valor varia por distribuição; não copie o alheio. Ver docs/instalacao.md.
DOCKER_GID=999

# API
API_PORT=8080

# Gateway (deploy/gateway/Caddyfile) - um subdomínio por serviço.
# Em staging/produção, aponte cada um para o domínio real; o Caddy emite o
# certificado via Let's Encrypt automaticamente a partir daqui.
GATEWAY_APP_DOMAIN=app.localhost
GATEWAY_API_DOMAIN=api.localhost
GATEWAY_CODEGEN_DOMAIN=codegen.localhost
GATEWAY_WORKER_DOMAIN=worker.localhost


# Credenciais do Grafana Cloud para o Alloy (deploy/observability/config.alloy).
#
# Onde encontrar: no Grafana Cloud, abra sua stack -> "Connections" (ou
# "Fleet Management") -> "Add new connection" -> "Alloy" -> método "Docker".
# O assistente gera um snippet com os valores reais desta conta/região -
# copie de lá, não invente os valores aqui.

# Endpoint remote_write de métricas (Mimir/Prometheus) e o ID da instância.
GCLOUD_HOSTED_METRICS_URL=https://<sua-instancia>.grafana.net/api/prom/push
GCLOUD_HOSTED_METRICS_ID=troque-me

# Endpoint push de logs (Loki) e o ID da instância.
GCLOUD_HOSTED_LOGS_URL=https://<sua-instancia>.grafana.net/loki/api/v1/push
GCLOUD_HOSTED_LOGS_ID=troque-me

# API key/token com escopo de escrita (metrics:write e logs:write), gerado
# junto com o snippet acima. Trate como segredo - não commitar em .env real.
GCLOUD_RW_API_KEY=troque-me

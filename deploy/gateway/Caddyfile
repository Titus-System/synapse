# Ponto único de entrada do droplet: termina TLS e roteia por subdomínio pra
# a aplicação e o Keycloak. Nenhum outro serviço expõe porta 80/443.

app.synnapse.pro {
	root * /srv/app
	encode gzip

	@assets path /assets/*

	# route{} keeps these in the written order — Caddy's automatic directive
	# ordering would otherwise run the unconditional header after @assets'.
	route {
		# Only the hashed Vite assets are safe to cache forever.
		header Cache-Control "no-cache"
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# SPA: unknown paths fall back to index.html for vue-router.
		try_files {path} /index.html
		file_server
	}
}

auth.synnapse.pro {
	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-Port 443
		header_up -X-Forwarded-Prefix
	}
}

api.synnapse.pro {
	reverse_proxy api:8080
}

codegen.synnapse.pro {
	reverse_proxy codegen:8000
}

worker.synnapse.pro {
	reverse_proxy worker:8000
}

# Healthcheck interno do próprio gateway, isolado dos blocos acima pra não
# entrar no redirecionamento automático de HTTPS.
:8080 {
	respond /healthz 200
}

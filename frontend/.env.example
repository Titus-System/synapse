# cp .env.example .env
# Only VITE_ variables reach the client — and all of them are visible in the bundle.
# Never put a secret here: keys and tokens live in the backend.

VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=synapse
VITE_KEYCLOAK_CLIENT_ID=synapse-frontend

# GUI git clients (VS Code included) spawn a minimal shell that skips
# .bashrc/.zshrc, so a version manager set up there never loads and this
# falls back to the system Node — best-effort load it here instead.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use
[ -s "$NVM_DIR/nvm.sh" ] && nvm use --silent 2>/dev/null
command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd 2>/dev/null)" 2>/dev/null

node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)
if [ -z "$node_major" ] || [ "$node_major" -lt 22 ]; then
  echo "This project needs Node 24 (got: $(node -v 2>/dev/null || echo 'none on PATH'))." >&2
  echo "See README.md#requirements. If this is a GUI git client (VS Code, etc.)," >&2
  echo "it may not be loading your shell's nvm/fnm setup." >&2
  exit 1
fi

make pre-commit
